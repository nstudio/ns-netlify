{
  "compilerOptions": {
    "strict": false,
    "module": "esnext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmitHelpers": true,
    "skipLibCheck": true,
    "lib": [
      "ESNext",
      "dom"
    ],
    "paths": {
      "~/*": [
        "./app/*"
      ]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "ns-edge-jsx/react",
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "app/**/*"
  ],
  "files": [
    "./references.d.ts"
  ],
  "exclude": [
    "node_modules",
    "platforms",
    "server"
  ]
}
